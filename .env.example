# ---- Firebase client (safe to expose to browser) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (server only — NEVER expose) ----
# Paste the full service-account JSON as a single-line string, or point
# GOOGLE_APPLICATION_CREDENTIALS at a file path outside the repo.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# ---- OpenAI (server only) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ---- USDA FoodData Central (server only) ----
# Free grounding lookup for simple, named foods (src/lib/nutrition/usda.ts) —
# used to correct the model's own calorie/protein guess before falling back
# to it. Get a free key at https://fdc.nal.usda.gov/api-key-signup.html; if
# unset, falls back to USDA's shared "DEMO_KEY" (rate-limited, fine for
# light testing but not for regular use).
USDA_FDC_API_KEY=

# ---- Apple Health ingest endpoint ----
# Shared secret the iOS Shortcut must send as `Authorization: Bearer <token>`.
# Generate a long random value, e.g.  openssl rand -hex 32
HEALTH_INGEST_TOKEN=

# ---- Security alert email (server only) ----
# Sent when the chat's prompt-injection guard (src/lib/chat/security.ts)
# flags a message. If any of these are unset, the alert is skipped (logged
# to the server console instead) rather than breaking the chat response.
# For Gmail: use an App Password (myaccount.google.com/apppasswords), not
# your normal password — plain-password SMTP auth is disabled on Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SECURITY_ALERT_EMAIL_TO=
