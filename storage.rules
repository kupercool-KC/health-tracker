rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can only read/write their own uploaded food photos.
    match /users/{userId}/nutrition-images/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can only read/write their own uploaded workout-summary screenshots.
    match /users/{userId}/workout-images/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
