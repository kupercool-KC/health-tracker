rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own subtree. Writes from the client are
    // allowed for reads; server-side writes go through the Admin SDK (which
    // bypasses these rules), so we keep client writes tight.
    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Client writes disabled by default — nutrition and workouts are written
      // server-side via API routes. Loosen deliberately if you add client writes.
      allow write: if false;
    }

    // Profile/memory/alerts docs (users/{uid}/meta/{profile|memory|alerts}) —
    // unlike healthTokenHash on the users/{uid} doc itself, these aren't
    // security-sensitive, and the Profile screen edits them directly from the
    // client (language toggle, dietary prefs, goals, memory notes, etc.).
    match /users/{userId}/meta/{document} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // The users/{uid} document itself (not matched by the wildcard above)
    // holds healthTokenHash — never exposed to clients, only the Admin SDK
    // (via /api/settings/health-token) reads/writes it.
    match /users/{userId} {
      allow read, write: if false;
    }

    // Reverse lookup from a Health Sync token's hash to its owning uid.
    // Only ever touched by the Admin SDK (createHealthToken /
    // resolveUidFromHealthToken), never by a client.
    match /healthTokens/{hash} {
      allow read, write: if false;
    }
  }
}
